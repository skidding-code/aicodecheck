# Copy to .env and adjust. All variables are prefixed AIPD_.

# --- General ---
AIPD_ENVIRONMENT=development
# Comma-separated origins allowed by CORS.
AIPD_CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# --- Persistence ---
# SQLite (default, zero-infra):
AIPD_DATABASE_URL=sqlite:///./aipd.db
# Postgres (production):
# AIPD_DATABASE_URL=postgresql+psycopg://aipd:aipd@db:5432/aipd

# --- Queue / cache ---
# Leave unset to use the in-process thread-pool queue (single node / dev).
# Set to enable durable, multi-worker RQ jobs:
# AIPD_REDIS_URL=redis://redis:6379/0

# --- Security / limits ---
AIPD_RATE_LIMIT_PER_MINUTE=30
AIPD_MAX_UPLOAD_BYTES=104857600          # 100 MiB
AIPD_MAX_SNIPPET_BYTES=1048576           # 1 MiB
AIPD_MAX_REPO_FILES=50000
AIPD_CLONE_TIMEOUT_SECONDS=600
AIPD_ALLOW_PRIVATE_NETWORK_TARGETS=false # SSRF guard; keep false in production

# Fernet key for encrypting access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a per-process key is used (tokens won't survive a restart).
# AIPD_TOKEN_ENCRYPTION_KEY=

# --- Worker ---
AIPD_WORK_DIR=/tmp/aipd-work
AIPD_ANALYSIS_CACHE_TTL_SECONDS=86400
