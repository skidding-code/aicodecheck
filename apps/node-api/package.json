{
  "name": "@aicodecheck/node-api",
  "version": "0.1.0",
  "description": "Node.js (Express + TypeScript) REST API for the AI Project Detector. Mirrors the Python API surface, reusing the shared @aicodecheck/detector-core engine.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aicodecheck/detector-core": "file:../../packages/detector-core-ts",
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "yauzl": "^3.2.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@types/yauzl": "^2.10.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
