# AI Project Detector — Node API configuration.
# Copy to .env and adjust. All values are optional: with none set, the app runs
# with zero external infrastructure (SQLite + in-process job queue).

PORT=8080

# --- Optional production backends ------------------------------------------- #
# Use Postgres instead of SQLite:
# DATABASE_URL=postgres://aipd:aipd@localhost:5432/aipd
# Use BullMQ + Redis instead of the in-process queue:
# REDIS_URL=redis://localhost:6379

# SQLite file path (when DATABASE_URL is unset)
# SQLITE_PATH=./aipd.db

# --- Security / limits ------------------------------------------------------ #
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_BYTES=104857600
MAX_SNIPPET_BYTES=1048576
MAX_REPO_FILES=50000
CLONE_TIMEOUT_SECONDS=600
ALLOW_PRIVATE_NETWORK_TARGETS=false
# TOKEN_ENCRYPTION_KEY=change-me-in-production

# --- Zip-bomb guard --------------------------------------------------------- #
MAX_ZIP_ENTRIES=50000
MAX_ZIP_UNCOMPRESSED_BYTES=524288000
MAX_ZIP_FILE_BYTES=26214400
MAX_ZIP_RATIO=200

# --- Worker / cache --------------------------------------------------------- #
ANALYSIS_CACHE_TTL_SECONDS=86400
# WORK_DIR=/tmp/aipd-work
